# 复制为项目根目录 .env。更方便的做法是在网页的「服务与 key」里设置（存在 studio/data/settings.json，优先于这里）。
# 旧版逐空判断（/legacy）用 Jev key；其余都由下面选的服务商负责。
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_MS=10000
# 可逆显示动作的试用门槛，需要实测校准。
JEV_MIN_CONFIDENCE=0.80
JEV_MIN_PROBABILITY_GAP=0.20
# 隐藏提示使用更严格的门槛。
JEV_HIDE_MIN_CONFIDENCE=0.90
JEV_MIN_CUE_MS=3000
STUDIO_PORT=4317

# 网页内容整理、材料生成和整句自动审查；填入后重启 npm start。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
# 多句材料生成可等待更久，独立于整句审查超时。
GEMINI_PREPARATION_TIMEOUT_MS=60000

# 语音陪练（Gemini Live）。这些模型只支持 bidiGenerateContent，与上面的审查模型分开配置。
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
# 思考级别只对 thinking 版 live 模型生效：LOW / MEDIUM / HIGH。LOW 轮替最快。
VOICE_THINKING_LEVEL=LOW
# 单次语音会话上限（秒），30–3600。
VOICE_MAX_SECONDS=600
# 多久没人说话（包括陪练）就自动结束会话（秒），15–3600。进入每一块会自动开始讲解，这条防止离开时一直计费。
VOICE_IDLE_SECONDS=90

# 所有文字调用（整理、短语检查、提示、中文语序、整句提示与点评）都用上面的 GEMINI_MODEL。
# 文字模型先思考多少再回答：minimal / low / medium / high；留空用模型默认（3.8-flash 默认 medium，提示约 7 秒，low 约 3 秒）。
GEMINI_THINKING_LEVEL=low
# 短语检查、提示、中文语序是写的时候在等的调用；3.8-flash 先思考再回答，检查约 2.5–5 秒、提示约 6 秒，超时留足余量。
GEMINI_NOTE_TIMEOUT_MS=20000

# 短语判定：gemini（默认，单层判定并给出理由）或 jev（旧的两层：分类器 + 裁决）。
PHRASE_GATE=gemini

# 文字部分（整理、检查、提示、点评、讲解稿）用谁：gemini（默认）、deepseek、qwen（阿里云百炼）。
TEXT_PROVIDER=gemini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 阿里云百炼：一个 key 同时用于千问文字和 Qwen-Omni 语音。key 按区域分开：cn-beijing（中国大陆）或 ap-southeast-1（国际）。
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
# 业务空间 ID：本机版可以不填；插件版的百炼语音必须填。
DASHSCOPE_WORKSPACE_ID=
QWEN_TEXT_MODEL=qwen3.8-max
# 千问先思考再回答会慢很多（检查 9–14 秒），默认关闭：on / off。
QWEN_THINKING=off

# 语音陪练用谁：gemini（默认，Gemini Live）、qwen（百炼 Qwen-Omni-Realtime）、none（不用语音）。
VOICE_PROVIDER=gemini
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
QWEN_VOICE=longanlingxin

# 朗读提示和讲解稿：gemini（自然，要 Gemini key）或 browser（浏览器自带的声音，不花钱）。没有 Gemini key 时默认 browser。
SPEECH_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# 改错小测做成卡片推送到 Anki（AnkiConnect）：本机版默认 on。
ANKI_PUSH=on
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_DECK=一句::改错
